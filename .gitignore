# ===========================================================================
# Juego de Memoria con Arduino — archivos que NO se versionan
# ===========================================================================

# ---- Ruido del sistema operativo / sincronización (OneDrive, iCloud, etc.) ----
.DS_Store
Thumbs.db
Thumbs.db:encryptable
desktop.ini
*.lnk

# ---- Logs ----
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# ---- Arduino / arduino-cli ----
# Salida de compilación del firmware: nunca se versiona, se regenera al subir
build/
.arduino/
*.hex
*.elf
*.eep
*.map

# Dependency directories
# node_modules/ la genera 'npm install' en cada equipo: son varios MB y se
# reconstruye a partir de package.json + package-lock.json, por eso no se versiona.
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ===========================================================================
# Específico del proyecto: Juego de Memoria con Arduino
# ===========================================================================

# ---- Editores / IDE ----
.vscode/
.idea/
.history/

# ---- Respaldos y archivos temporales ----
*.bak
*.tmp
*~
# Restos de merges, parches o conflictos sin resolver
*.orig
*.rej

# ---- Datos locales del juego ----
# leaderboard.json solo contiene los puntajes de la partida y lo regenera el
# servidor en cada equipo, así que no se versiona. Si quieres que deje de
# rastrearse por completo (ya fue commiteado antes):
#   git rm --cached leaderboard.json
leaderboard.json
leaderboard.json.*
